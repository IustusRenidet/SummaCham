# ============================================
# Configuración de Entorno - PanelAMCHAM
# ============================================

# --- MODO DE EJECUCIÓN ---
# Valores: 'development' | 'production'
NODE_ENV=development

# --- CONFIGURACIÓN FIREBIRD ---
# Host del servidor Firebird
FIREBIRD_HOST=127.0.0.1

# Puerto de conexión Firebird
# Desarrollo: 3050 (directo)
# Producción: 15350 (túnel TCP)
FIREBIRD_PORT=3050

# Credenciales Firebird
FIREBIRD_USER=sysdba
FIREBIRD_PASSWORD=masterkey

# --- CONFIGURACIÓN SERVIDOR HTTP ---
# Puerto del servidor backend Node.js
SERVER_PORT=3005

# --- NOTAS ---
# Desarrollo local:
#   - FIREBIRD_PORT=3050 (acceso directo a Firebird)
#   - NODE_ENV=development
#
# Producción (túnel):
#   - FIREBIRD_PORT=15350 (túnel TCP a Firebird remoto)
#   - NODE_ENV=production
