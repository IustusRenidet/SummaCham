# ============================================
# CONFIGURACIÓN DE ENTORNO - SummaCham
# ============================================
# Copia este archivo como .env y configura los valores reales

# --- MODO DE EJECUCIÓN ---
# Valores: 'development' | 'production'
NODE_ENV=development

# --- PUERTO DEL SERVIDOR ---
PORT=3005

# --- SECRETO PARA SESIONES ---
# Genera uno único con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=CAMBIAR_POR_UN_SECRETO_SEGURO_ALEATORIO

# --- CONTRASEÑA DEL ADMINISTRADOR ---
# Usuario ICONET (administrador global)
# Si no se define, se genera una contraseña aleatoria en cada inicio
PANELAMCHAM_ADMIN_PASSWORD=CAMBIAR_POR_CONTRASEÑA_SEGURA

# --- CONFIGURACIÓN FIREBIRD ---
# Host del servidor Firebird
FIREBIRD_HOST=127.0.0.1

# Puerto de conexión Firebird
# Desarrollo: 3050 (directo)
# Producción: 15350 (túnel TCP)
FIREBIRD_PORT=3050

# Credenciales Firebird
FIREBIRD_USER=sysdba
FIREBIRD_PASSWORD=masterkey

# --- CONFIGURACIÓN SERVIDOR HTTP ---
# Puerto del servidor backend Node.js
SERVER_PORT=3005

# --- EXPORTACION EXCEL NATIVA (WEB) ---
# Engine nativo:
#   - openpyxl: usa Python + openpyxl (sin COM/licencia Office)
#   - com: usa PowerShell + COM Excel
#   - auto: intenta openpyxl y si falla cae a COM
EXCEL_NATIVE_ENGINE=openpyxl

# Binario/comando Python opcional.
# Admite ruta absoluta (recomendado en servicio Windows) o comando (ej: py -3).
# Si no se define, se intenta: venv administrado, py -3, py, python, python3.
# EXCEL_NATIVE_PYTHON_BIN="C:\\Users\\Administrador\\AppData\\Local\\Programs\\Python\\Python314\\python.exe"

# Si está en 1, intenta auto-crear un venv e instalar openpyxl en primer arranque
EXCEL_NATIVE_AUTO_BOOTSTRAP=1

# Ruta opcional para runtime administrado (venv/caché)
# EXCEL_NATIVE_RUNTIME_DIR=C:\\panel-amcham\\excel-native

# Python base opcional para crear el venv administrado
# EXCEL_NATIVE_BOOTSTRAP_PYTHON_BIN=py

# Timeout por intento de exportacion nativa (ms)
EXCEL_NATIVE_TIMEOUT_MS=300000

# Timeout para el proceso Python/openpyxl (ms)
EXCEL_NATIVE_PYTHON_TIMEOUT_MS=300000

# --- NOTAS ---
# Desarrollo local:
#   - FIREBIRD_PORT=3050 (acceso directo a Firebird)
#   - NODE_ENV=development
#
# Producción (túnel):
#   - FIREBIRD_PORT=15350 (túnel TCP a Firebird remoto)
#   - NODE_ENV=production
