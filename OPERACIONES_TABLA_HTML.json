  "operaciones_globales": {
    "recalcular_totales_horizontales": {
      "descripcion": "Recalcula total-budget, total-real, budget-annual y budget-monthly de cada fila-cuenta",
      "funcion": "recalcularTotalesFilaPresupuesto()",
      "archivo": "vistas/js/cuentas-modulo.js",
      "lineas": "800-850",
      "trigger": "Después de editar valores en celdas de presupuesto",
      "operaciones": [
        {
          "columna": "total-budget",
          "formula": "SUM(budget-ene, budget-feb, ..., budget-[periodo_cerrado])",
          "descripcion": "Suma acumulada desde enero hasta el mes cerrado",
          "nota": "Excluye el mes en curso"
        },
        {
          "columna": "total-real",
          "formula": "SUM(real-ene, real-feb, ..., real-[periodo_cerrado])",
          "descripcion": "Suma acumulada desde enero hasta el mes cerrado",
          "nota": "Excluye el mes en curso"
        },
        {
          "columna": "budget-annual",
          "formula": "SUM(budget-ene, budget-feb, ..., budget-dic)",
          "descripcion": "Suma completa de los 12 meses del año",
          "nota": "Independiente del periodo cerrado"
        },
        {
          "columna": "budget-monthly",
          "formula": "real-[mes_actual]",
          "descripcion": "Valor del mes actual para módulo Gastos Corporativos",
          "nota": "Solo el valor del último mes cerrado"
        }
      ],
      "pseudocodigo": [
        "function recalcularTotalesFilaPresupuesto(fila) {",
        "  const cuenta = fila.dataset.cuenta21;",
        "  const valores = estadoModulo.valoresPorCuenta.get(cuenta);",
        "  const mesActualIndex = obtenerIndicePeriodoActual();",
        "  ",
        "  let totalBudget = 0;",
        "  let totalReal = 0;",
        "  let annualBudget = 0;",
        "  ",
        "  MESES.forEach((mes, index) => {",
        "    const budget = valores[`budget-${mes}`] || 0;",
        "    const real = valores[`real-${mes}`] || 0;",
        "    ",
        "    // Annual: sumar todo",
        "    annualBudget += budget;",
        "    ",
        "    // Total: sumar solo hasta mes cerrado",
        "    if (index <= mesActualIndex) {",
        "      totalBudget += budget;",
        "      totalReal += real;",
        "    }",
        "  });",
        "  ",
        "  // Monthly: solo el mes actual",
        "  const mesActual = MESES[mesActualIndex];",
        "  const monthly = valores[`real-${mesActual}`] || 0;",
        "  ",
        "  // Actualizar celdas",
        "  establecerValorCelda(fila, 'total-budget', totalBudget);",
        "  establecerValorCelda(fila, 'total-real', totalReal);",
        "  establecerValorCelda(fila, 'budget-annual', annualBudget);",
        "  establecerValorCelda(fila, 'budget-monthly', monthly);",
        "}"
      ]
    },

