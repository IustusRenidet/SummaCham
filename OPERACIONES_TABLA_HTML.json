    "ajuste_por_periodo": {
      "descripcion": "Oculta columnas de meses posteriores al periodo cerrado",
      "funcion": "aplicarFiltroColumnasPorPeriodo()",
      "archivo": "vistas/js/cuentas-modulo.js",
      "lineas": "1400-1450",
      "logica": {
        "condicion": "Si año seleccionado === año actual",
        "accion": "Ocultar columnas real-[mes] donde mes > periodo_cerrado",
        "ejemplo": "Si periodo cerrado = 6 (junio), ocultar real-jul, real-ago, ..., real-dic"
      },
      "implementacion": [
        "const periodoVisible = obtenerPeriodoVisible();",
        "Object.entries(estadoModulo.columnas).forEach(([clave, idx]) => {",
        "  if (!clave.startsWith('real-')) return;",
        "  const mes = clave.replace('real-', '');",
        "  const mesNum = CLAVE_MES_A_PERIODO.get(mes);",
        "  const ocultar = mesNum > periodoVisible;",
        "  filas.forEach(fila => {",
        "    fila.cells[idx].style.display = ocultar ? 'none' : '';",
        "  });",
        "});"
      ]
    }
  },

