{
  "name": "summacham",
  "version": "1.0.0",
  "description": "Dashboard financiero SummaCham empaquetado como app de escritorio portable.",
  "main": "main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.3.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.summa.cham",
    "productName": "SummaCham",
    "asar": true,
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "vistas/**/*",
      "build/icon.png",
      "build/icon.ico",
      "README.md"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false,
      "publisherName": [
        "Unsigned Build"
      ]
    }
  }
}