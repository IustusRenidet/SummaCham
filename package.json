{
  "name": "PanelAMCHAM",
  "version": "1.0.0",
  "description": "Dashboard financiero PanelAMCHAM empaquetado como app de escritorio portable.",
  "main": "main.js",
  "author": "Iustus Renidet & J02V4N",
  "license": "",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win portable",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^38.2.2",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.summa.cham",
    "productName": "PanelAMCHAM",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "icono"
    },
    "files": [
      "main.js",
      "vistas/**/*",
      "icono/icono.png",
      "icono/icono.ico",
      "README.md"
    ],
    "extraResources": [
      {
        "from": "vistas",
        "to": "resources/vistas"
      }
    ],
    "portable": {
      "artifactName": "${productName}-portable-${version}-${arch}.${ext}",
      "useZip": false,
      "requestExecutionLevel": "user"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icono/icono.ico",
      "signAndEditExecutable": false,
      "publisherName": [],
      "artifactName": "${productName}-portable-${version}-${arch}.${ext}"
    }
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.4.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "node-firebird": "^1.1.9"
  }
}
