{
  "name": "panel-amcham",
  "version": "1.0.1",
  "description": "Dashboard financiero PanelAMCHAM empaquetado como app de escritorio portable.",
  "main": "main.js",
  "author": "Iustus Renidet & J02V4N",
  "license": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/IustusRenidet/SummaCham.git"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis",
    "publish": "electron-builder --win --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.27.1"
  },
  "build": {
    "appId": "com.summa.cham",
    "productName": "PanelAMCHAM",
    "publish": [
      {
        "provider": "github",
        "owner": "IustusRenidet",
        "repo": "SummaCham"
      }
    ],
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "icono"
    },
    "files": [
      "main.js",
      "src/**/*",
      "vistas/**/*",
      "icono/icono.png",
      "icono/icono.ico",
      "README.md"
    ],
    "portable": {
      "artifactName": "${productName}-portable-${version}-${arch}.${ext}",
      "useZip": false,
      "requestExecutionLevel": "user"
    },
    "asarUnpack": [
      "**/node_modules/better-sqlite3/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ],
      "icon": "icono/icono.ico",
      "signAndEditExecutable": false,
      "publisherName": [],
      "artifactName": "${productName}-portable-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "icono/icono.ico",
      "uninstallerIcon": "icono/icono.ico",
      "displayLanguageSelector": false
    },
    "extraResources": [
      {
        "from": "icono",
        "to": "icono"
      }
    ]
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.5.0",
    "csv-parse": "^6.1.0",
    "electron-updater": "^6.6.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.3",
    "node-firebird": "^1.1.9",
    "nodemailer": "^7.0.10",
    "xlsx": "^0.18.5"
  }
}
